# ── Required ──────────────────────────────────────────────────────────────────
# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# ── Image Generation (add any — priority: CF → HF → DALL-E → Grok → Pollinations)

# Cloudflare Workers AI — FREE (10k neurons/day, no card needed)
# Account ID: dash.cloudflare.com → right sidebar
# API Token: dash.cloudflare.com/profile/api-tokens → "Workers AI" template
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# HuggingFace — FREE with token (FLUX.1-schnell + SDXL)
# https://huggingface.co/settings/tokens → New Token (Read)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# OpenAI DALL-E 3 — paid, highest quality
OPENAI_API_KEY=your_openai_key_here

# Grok/xAI — paid
GROK_API_KEY=your_grok_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
GEMINI_MODEL=gemini-3.5-flash
