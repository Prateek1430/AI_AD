# Google AI Studio key (required) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# OpenAI key (optional) — enables DALL-E 3 image generation
# If not set, falls back to Flux via Pollinations.ai (free)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

PORT=3001
GEMINI_MODEL=gemini-3.5-flash
